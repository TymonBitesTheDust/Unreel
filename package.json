{
  "name": "unreel",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "npm run sync:swift && expo run:ios",
    "prebuild": "npm run sync:swift && expo prebuild --clean",
    "sync:swift": "node scripts/sync-shared-swift.mjs",
    "check:swift": "node scripts/sync-shared-swift.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:android": "cd android && ./gradlew :unreel-blocker:testDebugUnitTest",
    "build:userscript": "node scripts/build-userscript.mjs",
    "check:userscript": "node scripts/build-userscript.mjs --check"
  },
  "private": true
}
